# --- Supabase ---
# Supabase ダッシュボード > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# オーナー(このアプリを使える唯一のアカウント)のメールアドレス。
# これ以外のアカウントでログインしても全ページにアクセスできない。
OWNER_EMAIL=owner@example.com

# --- Anthropic (Claude API) ---
# サーバー側でのみ使用。NEXT_PUBLIC_ を付けないこと。
ANTHROPIC_API_KEY=sk-ant-...
# 1 にすると Claude API を呼ばずに固定の模擬応答を返す(E2Eテスト・デモ用)
AI_MOCK=0

# --- E2E テスト専用(本番環境には設定しない) ---
# ローカル Supabase (npx supabase start) の service_role キー。テストユーザー作成にのみ使用。
# SUPABASE_SERVICE_ROLE_KEY=
# E2E_OWNER_PASSWORD=
